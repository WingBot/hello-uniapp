# uni-app 项目 .gitignore 文件

# 编译输出目录
unpackage/
dist/
build/

# 依赖目录
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 环境配置文件
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE 配置文件
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统生成的文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 日志文件
*.log
logs/

# 临时文件
*.tmp
*.temp
.tmp/
.temp/

# 缓存文件
.cache/
.parcel-cache/

# 微信开发者工具生成的文件
project.config.json
project.private.config.json

# HBuilderX 生成的文件
.hbuilderx/

# 其他编译输出
*.map
*.min.js
*.min.css

# 测试覆盖率报告
coverage/
.nyc_output/

# 包管理器锁文件（根据项目需要选择保留）
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# 本地开发配置
local.properties
